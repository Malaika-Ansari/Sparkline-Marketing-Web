# ==============================================================================
# SPARKLINE MARKETING — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel, Cloud Run, Supabase), configure these variables
# directly in the hosting provider's secure secret manager.
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit actual production API keys or tokens to version control.
# 2. Variables prefixed with VITE_ are embedded into frontend client bundles at build time.
#    NEVER put secret API keys, private database passwords, or OAuth client secrets in VITE_ variables!
# 3. Server-side secrets (GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY, OAuth secrets)
#    are ONLY accessed by backend server proxies and NEVER exposed to client browsers.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core Configuration
# ------------------------------------------------------------------------------
VITE_APP_NAME="Sparkline Marketing"
VITE_APP_ENV="production"
VITE_APP_URL="https://sparklinemarketing.com"
VITE_APP_VERSION="0.1.0"
PORT=3000

# ------------------------------------------------------------------------------
# 2. Database & Authentication (Cloud Supabase Mode)
# ------------------------------------------------------------------------------
# In local development or zero-config mode, the Sparkline Local Vault operates automatically.
# For production multi-tenant database synchronization, configure your Supabase project:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-jwt-key"

# Vercel Server-Side Supabase Variables (Used by Vercel Serverless Functions)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-jwt-key"

# Server-side service role key (OPTIONAL: For administrative tasks / webhooks only)
# NEVER expose this key to client-side bundles (do not prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY="your-server-service-role-secret-key"

# ------------------------------------------------------------------------------
# 3. AI Marketing Strategist Engine (Google Gemini API)
# ------------------------------------------------------------------------------
# Required for live server-side AI strategy generation, SEO content synthesis,
# and competitor intelligence analysis.
# Runs through protected server proxy (/api/generate-strategy, etc.) with rate limiting.
# Obtain a production key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 4. Exchange Rate Feed (Multi-Currency Converter — Phase 13)
# ------------------------------------------------------------------------------
# Optional: Live foreign exchange rate feed API.
# If omitted or unconfigured, Sparkline automatically falls back to built-in institutional rates.
EXCHANGE_RATE_API_KEY="your-exchange-rate-api-key"

# ------------------------------------------------------------------------------
# 5. Third-Party Platform Connectors (OAuth 2.0 Credentials — Phase 23)
# ------------------------------------------------------------------------------
# Required ONLY when connecting live ad accounts and analytics platforms.
# When omitted, the platform provides interactive Sandbox Mode for zero-risk testing.
#
# Meta Marketing API (Facebook & Instagram Ads)
# Scopes: ads_read, read_insights
META_CLIENT_ID="your-meta-app-id"
META_CLIENT_SECRET="your-meta-app-secret"

# Google Ads & Google Analytics 4 (Google Cloud Console)
# Scopes: https://www.googleapis.com/auth/adwords, https://www.googleapis.com/auth/analytics.readonly
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# TikTok Marketing API
# Scopes: ad.read, report.read
TIKTOK_CLIENT_ID="your-tiktok-app-id"
TIKTOK_CLIENT_SECRET="your-tiktok-app-secret"

# LinkedIn Marketing Solutions API
# Scopes: r_ads, r_ads_reporting
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

# Twitter / X Ads API
# Scopes: tweet.read, users.read
TWITTER_CLIENT_ID="your-twitter-client-id"
TWITTER_CLIENT_SECRET="your-twitter-client-secret"

# ------------------------------------------------------------------------------
# 6. Integration Token Encryption (AES-256-GCM)
# ------------------------------------------------------------------------------
# 32-byte hex-encoded cryptographic master key used to encrypt OAuth refresh tokens
# and sensitive credentials at rest in the database.
# Generate on Linux/macOS: openssl rand -hex 32
TOKEN_ENCRYPTION_SECRET="generate-32-byte-hex-secret-key-here"

# ------------------------------------------------------------------------------
# 7. Security & Telemetry Controls
# ------------------------------------------------------------------------------
# Enforces strict origin checking for API CORS
ALLOWED_ORIGINS="https://sparklinemarketing.com"
